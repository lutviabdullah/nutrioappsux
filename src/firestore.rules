rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model:
    // profiles/{uid}: full_name (string, required, 1-120 chars), university
    // and faculty (strings, required, 0-160 chars), semester (null or integer
    // 1-20). This document is private to its owner.
    // education/{id}: title (string, <=120 chars), summary (string, <=2000),
    // action (string, <=1000), icon (string, <=40), sort_order (integer), and
    // is_published (boolean). Signed-in users read published documents only;
    // shared content is written by trusted tooling, never by app clients.
    // food_catalog/{id}: name (string, <=150 chars), subtitle/description
    // (optional strings, <=255/2000), emoji (optional string, <=20),
    // category_name (string, <=80), base_price (non-negative number),
    // nutrition_score and eco_score (integers, 0-100), recommendation
    // (string, <=2000), and optional nutrition/rating numbers. Signed-in users
    // may read this non-personal catalog; app clients cannot write it.

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['full_name', 'university', 'faculty', 'semester'])
        && data.keys().hasOnly(['full_name', 'university', 'faculty', 'semester'])
        && data.full_name is string
        && data.full_name.size() > 0
        && data.full_name.size() <= 120
        && data.university is string
        && data.university.size() <= 160
        && data.faculty is string
        && data.faculty.size() <= 160
        && (data.semester == null || (data.semester is int && data.semester >= 1 && data.semester <= 20));
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidProfile(request.resource.data);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidProfile(request.resource.data);
      allow delete: if false;
    }

    match /education/{educationId} {
      allow read: if isSignedIn() && resource.data.is_published == true;
      allow write: if false;
    }

    match /food_catalog/{foodId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /ingredients/{ingredientId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /food_categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /nutrition_menu_views/{foodId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      function isValidMealLog() {
        let data = request.resource.data;
        let foodPath = /databases/$(database)/documents/food_catalog/$(data.food_id);
        let foodSnapshot = get(foodPath);
        let food = foodSnapshot.data;
        let unitPrice = food.keys().hasAny(['base_price_minor'])
          ? food.base_price_minor
          : food.base_price;
        let calories = food.keys().hasAny(['calories_kcal']) ? food.calories_kcal : 0;
        let protein = food.keys().hasAny(['protein_g']) ? food.protein_g : 0;
        let fiber = food.keys().hasAny(['fiber_g']) ? food.fiber_g : 0;
        let currency = food.keys().hasAny(['currency_code']) ? food.currency_code : 'IDR';

        return isSignedIn()
          && request.auth.uid == userId
          && exists(foodPath)
          && data.keys().hasAll([
            'food_id', 'food_name', 'servings', 'calories_kcal', 'protein_g',
            'fiber_g', 'unit_price_minor', 'amount_minor', 'currency_code',
            'day_id', 'created_at'
          ])
          && data.keys().hasOnly([
            'food_id', 'food_name', 'servings', 'calories_kcal', 'protein_g',
            'fiber_g', 'unit_price_minor', 'amount_minor', 'currency_code',
            'day_id', 'created_at'
          ])
          && data.food_id is string
          && data.food_name == food.name
          && data.servings is int
          && data.servings >= 1
          && data.servings <= 10
          && unitPrice is number
          && unitPrice >= 0
          && data.unit_price_minor == unitPrice
          && data.amount_minor == unitPrice * data.servings
          && data.calories_kcal == calories * data.servings
          && data.protein_g == protein * data.servings
          && data.fiber_g == fiber * data.servings
          && data.currency_code == currency
          && data.day_id is string
          && data.day_id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.created_at == request.time;
      }

      match /meal_logs/{logId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isValidMealLog();
        allow update, delete: if false;
      }

      match /nutrition_days/{dayId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /processed_meal_events/{eventId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}