generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String          @unique
  fullName      String?         @map("full_name")
  age           Int?
  gender        String?         @db.VarChar(30)
  heightCm      Int?            @map("height_cm")
  weightKg      Decimal?        @map("weight_kg") @db.Decimal(5, 2)
  activityLevel String?         @map("activity_level") @db.VarChar(40)
  dietaryGoal   String?         @map("dietary_goal") @db.VarChar(40)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  mealLogs      MealLog[]
  mealPlans     MealPlan[]
  preferences   UserPreference[]
  nutritionLedgerEntries NutritionLedgerEntry[]
  genderOption  GenderOption?   @relation(fields: [gender], references: [code], onDelete: SetNull, map: "fk_users_gender")
  activityOption ActivityLevel? @relation(fields: [activityLevel], references: [code], onDelete: SetNull, map: "fk_users_activity_level")
  dietaryGoalOption DietaryGoal? @relation(fields: [dietaryGoal], references: [code], onDelete: SetNull, map: "fk_users_dietary_goal")

  @@map("users")
}

model FoodCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String     @unique
  description String?
  createdAt DateTime   @default(now()) @map("created_at")
  foodItems FoodItem[]

  @@map("food_categories")
}

model FoodItem {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  subtitle        String?
  emoji           String?
  categoryId      String?           @map("category_id")
  category        FoodCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_food_items_category")
  description     String?
  basePrice       Decimal           @map("base_price") @db.Decimal(10, 2)
  nutritionScore  Int               @map("nutrition_score") @db.SmallInt
  ecoScore        Int               @map("eco_score") @db.SmallInt
  recommendation  String?
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  ingredients     FoodIngredient[]
  mealLogs        MealLog[]
  mealPlanItems   MealPlanItem[]
  foodNutrients   FoodNutrient[]
  reviews         FoodReview[]
  nutritionLedgerEntries NutritionLedgerEntry[]

  @@index([categoryId], map: "idx_food_items_category")
  @@index([name], map: "idx_food_items_name")
  @@map("food_items")
}

model Nutrient {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  unit        String
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  foodNutrients FoodNutrient[]

  @@map("nutrients")
}

model FoodNutrient {
  id         String   @id @default(cuid())
  foodId     String   @map("food_id")
  nutrientId String   @map("nutrient_id")
  value      Decimal  @db.Decimal(8, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  food       FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade, map: "fk_food_nutrients_food")
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade, map: "fk_food_nutrients_nutrient")

  @@unique([foodId, nutrientId], map: "uk_food_nutrients")
  @@index([foodId], map: "idx_food_nutrients_food")
  @@index([nutrientId, foodId], map: "idx_food_nutrients_nutrient_food")
  @@map("food_nutrients")
}

model Ingredient {
  id          String          @id @default(cuid())
  name        String          @unique
  categoryId  String?         @map("category_id") @db.Uuid
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  foodIngredients FoodIngredient[]
  category    IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "fk_ingredients_category")

  @@map("ingredients")
}

model FoodIngredient {
  id            String      @id @default(cuid())
  foodId        String      @map("food_id")
  ingredientId  String      @map("ingredient_id")
  quantityG     Decimal?    @map("quantity_g") @db.Decimal(6, 2)
  notes         String?
  food          FoodItem    @relation(fields: [foodId], references: [id], onDelete: Cascade, map: "fk_food_ingredients_food")
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade, map: "fk_food_ingredients_ingredient")

  @@unique([foodId, ingredientId], map: "uk_food_ingredients")
  @@index([ingredientId, foodId], map: "idx_food_ingredients_ingredient")
  @@map("food_ingredients")
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  foodId      String   @map("food_id")
  mealType    String   @map("meal_type")
  portionSize Decimal  @default(1.00) @map("portion_size") @db.Decimal(5, 2)
  servings    Decimal  @db.Decimal(5, 2) @default(1.00)
  loggedAt    DateTime @default(now()) @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_meal_logs_user")
  food        FoodItem @relation(fields: [foodId], references: [id], onDelete: Restrict, map: "fk_meal_logs_food")
  ledgerEntry NutritionLedgerEntry?
  type        MealType @relation(fields: [mealType], references: [code], onDelete: Restrict, map: "fk_meal_logs_type")

  @@index([userId, loggedAt(sort: Desc)], map: "idx_meal_logs_user_time")
  @@index([userId, foodId, loggedAt(sort: Desc)], map: "idx_meal_logs_user_food_time")
  @@map("meal_logs")
}

model MealPlan {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  name        String
  description String?
  startDate   DateTime       @map("start_date")
  endDate     DateTime?      @map("end_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_meal_plans_user")
  items       MealPlanItem[]

  @@index([userId, startDate(sort: Desc), endDate], map: "idx_meal_plans_user_dates")
  @@map("meal_plans")
}

model MealPlanItem {
  id            String     @id @default(cuid())
  mealPlanId     String     @map("meal_plan_id")
  foodId         String     @map("food_id")
  dayOfWeek      String?    @map("day_of_week")
  mealType       String?    @map("meal_type")
  targetServings Decimal    @default(1.00) @map("target_servings") @db.Decimal(5, 2)
  mealPlan      MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade, map: "fk_meal_plan_items_meal_plan")
  food          FoodItem   @relation(fields: [foodId], references: [id], onDelete: Restrict, map: "fk_meal_plan_items_food")
  type           MealType?  @relation(fields: [mealType], references: [code], onDelete: Restrict, map: "fk_meal_plan_items_type")

  @@index([mealPlanId, dayOfWeek], map: "idx_meal_plan_items_plan_day")
  @@index([foodId, mealPlanId], map: "idx_meal_plan_items_food")
  @@map("meal_plan_items")
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  preferenceName  String   @map("preference_name")
  preferenceValue String   @map("preference_value")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_preferences_user")

  @@unique([userId, preferenceName], map: "uk_user_preferences")
  @@map("user_preferences")
}

model FoodReview {
  id          String   @id @default(cuid())
  foodId      String   @map("food_id")
  reviewerName String  @map("reviewer_name")
  rating      Int      @db.SmallInt
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  food        FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade, map: "fk_food_reviews_food")

  @@index([foodId, createdAt(sort: Desc)], map: "idx_food_reviews_food_time")
  @@map("food_reviews")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableName  String   @map("table_name")
  rowId      String   @map("row_id")
  operation  String   @db.Char(1)
  oldRow     Json?    @map("old_row") @db.JsonB
  newRow     Json?    @map("new_row") @db.JsonB
  actorId    String?  @map("actor_id")
  requestId  String?  @map("request_id")
  occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)

  @@index([tableName, rowId, occurredAt(sort: Desc)], map: "idx_audit_table_row_time")
  @@map("audit_events")
}

model NutritionLedgerEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id")
  mealLogId   String   @unique @map("meal_log_id")
  foodId      String   @map("food_id")
  servings    Decimal  @db.Decimal(8, 2)
  caloriesKcal Decimal @map("calories_kcal") @db.Decimal(12, 2)
  proteinG    Decimal  @map("protein_g") @db.Decimal(12, 2)
  fiberG      Decimal  @map("fiber_g") @db.Decimal(12, 2)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt  DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(6)
  previousHash Bytes?  @map("previous_hash") @db.ByteA
  entryHash   Bytes    @unique @map("entry_hash") @db.ByteA
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_ledger_user")
  mealLog     MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Restrict, map: "fk_ledger_meal")
  food        FoodItem @relation(fields: [foodId], references: [id], onDelete: Restrict, map: "fk_ledger_food")

  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)], map: "idx_ledger_user_time")
  @@map("nutrition_ledger_entries")
}

model GenderOption {
  code  String  @id @db.VarChar(30)
  label String
  users User[]

  @@map("gender_options")
}

model ActivityLevel {
  code  String  @id @db.VarChar(40)
  label String
  users User[]

  @@map("activity_levels")
}

model DietaryGoal {
  code  String  @id @db.VarChar(40)
  label String
  users User[]

  @@map("dietary_goals")
}

model MealType {
  code          String          @id @db.VarChar(40)
  label         String
  mealLogs      MealLog[]
  planItems     MealPlanItem[]

  @@map("meal_types")
}

model IngredientCategory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @unique @db.VarChar(80)
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

model EducationCategory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String      @unique @db.VarChar(80)
  name       String      @unique @db.VarChar(80)
  education  Education[]

  @@map("education_categories")
}

model Education {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  title       String           @db.VarChar(120)
  categoryId  String           @map("category_id") @db.Uuid
  summary     String
  action      String           @default("")
  icon        String           @default("book-open") @db.VarChar(40)
  sortOrder   Int              @default(0) @map("sort_order") @db.SmallInt
  isPublished Boolean          @default(true) @map("is_published")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  category    EducationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([sortOrder, title], map: "idx_education_published_order")
  @@map("education")
}

model Profile {
  userId     String   @id @map("user_id") @db.Uuid
  fullName   String   @default("Nutrio User") @map("full_name")
  university String   @default("")
  faculty    String   @default("")
  semester   Int?     @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}
